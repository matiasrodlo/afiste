{
  "name": "afiste-backend",
  "version": "1.0.0",
  "description": "Afiste Backend API - Node.js/TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:demo": "ts-node prisma/demo-seed.ts",
    "backup": "./scripts/backup.sh",
    "backup:restore": "./scripts/restore.sh",
    "backup:setup-cron": "./scripts/setup-cron.sh",
    "migrate:test": "./scripts/test-migration.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "fintech",
    "vc",
    "tokenization",
    "blockchain",
    "venture-capital",
    "marketplace"
  ],
  "author": "Matías Rodlo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/matiasrodlo/afiste.git"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@safe-global/safe-core-sdk": "^3.1.1",
    "@safe-global/safe-ethers-lib": "^1.9.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "plaid": "^28.0.0",
    "prisma": "^5.20.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
